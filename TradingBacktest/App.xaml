<Application x:Class="TradingBacktest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- One height for every input, so a row of controls lines up instead of
             stepping up and down with the default metrics of each control template. The
             font is set on each input style too, because the DatePicker hands its text to
             an internal TextBox that no longer picks up the keyed TextBox style. -->
        <sys:Double x:Key="ControlHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2933" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6B7683" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF1E88E5" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFDCE1E6" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFC62828" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />

        <!-- Toggles the strategy look-back box on rules that have one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============================ inputs ============================ -->

        <!--
          Keyed, not implicit on purpose: an implicit TextBox style would also reach the
          box inside a DatePicker and an editable ComboBox, and its fixed Height would then
          fight the outer control's template. The chart's own fields opt in instead.
        -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#FFBFC7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <!-- No MinWidth on purpose: it used to win over an explicit Width and push the
                 narrow fields (cost, lookback, periods) out of their column. -->
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="126" />
            <!-- These two reach the text box inside the DatePicker template, which no
                 longer picks up the keyed TextBox style. Without them the date renders in
                 the theme's smaller default font. -->
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="6,0" />
            <!-- Same trap as the TextBox: a MinWidth here wins over the explicit Width of the
                 rule drop-down and shoves the look-back box out of its column. -->
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>


        <Style TargetType="Button">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Background" Value="#FF1E88E5" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF1976D2" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF42A5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1565C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB0BEC5" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFCFD8DC" />
                                <Setter Property="Foreground" Value="#FFECEFF1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFEFF2F5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#FFBFC7D0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============================ form ============================ -->

        <!-- Label on the left of a field row; it sits on the control's centre line. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- For a label that sits beside its control rather than above it. -->
        <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="5,0,5,0" />
        </Style>


        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
          One editor per IndicatorParameterType, looked up by ParameterTemplateSelector.
          A plug-in picks which one it gets by declaring its parameters, so the app needs
          no new code when an indicator wants a different setting.
        -->
        <DataTemplate x:Key="ParameterInteger">
            <TextBox Style="{StaticResource InputTextBox}"
                     Width="48"
                     ToolTip="{Binding Description}"
                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterNumber">
            <TextBox Style="{StaticResource InputTextBox}"
                     Width="54"
                     ToolTip="{Binding Description}"
                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterText">
            <TextBox Style="{StaticResource InputTextBox}"
                     Width="90"
                     ToolTip="{Binding Description}"
                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterChoice">
            <ComboBox Width="96"
                      ToolTip="{Binding Description}"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding Choice}" />
        </DataTemplate>
    </Application.Resources>
</Application>
