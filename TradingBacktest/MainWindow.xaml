<Window x:Class="TradingBacktest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TradingBacktest.Controls"
        xmlns:viewModels="clr-namespace:TradingBacktest.ViewModels"
        Title="Trading Backtest"
        Height="800"
        Width="1330"
        MinHeight="560"
        MinWidth="1300"
        Background="#FFF4F6F8"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Settings. Deliberately kept to two short rows: the chart is the point of the
          window, so the panel above it gets as little height as it can. One shared column
          grid keeps every label and control aligned, and every input shares the single
          ControlHeight so nothing steps up or down.
        -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="172" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="108" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- row 0: data -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,5">
                    <TextBlock Text="Ticker" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableTickers}"
                              IsEditable="True"
                              StaysOpenOnEdit="True"
                              IsTextSearchEnabled="True"
                              Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,5">
                    <TextBlock Text="Data folder" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource InputTextBox}" Width="214"
                                 Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0"
                                Command="{Binding BrowseFolderCommand}"
                                IsEnabled="{Binding CanBrowse}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,5">
                    <TextBlock Text="Period" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding FromDate}" ToolTip="First day of the tested period" />
                        <TextBlock Text="to" Style="{StaticResource InlineLabel}" />
                        <DatePicker SelectedDate="{Binding ToDate}" ToolTip="Last day of the tested period" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,5">
                    <TextBlock Text="Quick period" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1Y" Style="{StaticResource ChipButton}" Command="{Binding PeriodCommand}" CommandParameter="1Y" />
                        <Button Content="3Y" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="3Y" />
                        <Button Content="5Y" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="5Y" />
                        <Button Content="All" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="All" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,8,5">
                    <TextBlock Text="Cost, %" Style="{StaticResource FieldLabel}"
                               ToolTip="Commission, spread and tax charged on each buy and each sell, in percent" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="58"
                             Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Row="0"
                        Grid.Column="5"
                        Grid.ColumnSpan="2"
                        Content="Start"
                        MinWidth="104"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5"
                        Command="{Binding StartCommand}" />

                <!-- row 1: what to trade it with -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Buy/sell rule" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="140"
                                  ItemsSource="{Binding Strategies}"
                                  SelectedItem="{Binding SelectedStrategy}"
                                  DisplayMemberPath="Name" />
                        <TextBlock Text="bars"
                                   Style="{StaticResource InlineLabel}"
                                   Visibility="{Binding SelectedStrategy.HasLookback, Converter={StaticResource BoolToVis}}" />
                        <TextBox Style="{StaticResource InputTextBox}" Width="44"
                                 Text="{Binding SelectedStrategy.LookbackText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How many bars back the rule looks"
                                 Visibility="{Binding SelectedStrategy.HasLookback, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,8,0">
                    <TextBlock Text="Indicators" Style="{StaticResource FieldLabel}" />
                    <!-- Two equal star columns, so the slots stay parallel. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                            <ComboBox Width="128"
                                      ItemsSource="{Binding IndicatorChoices}"
                                      SelectedItem="{Binding Indicator1.Choice}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{Binding Indicator1.ChoiceName}" />
                            <TextBlock Text="period" Margin="6,0,4,0" Style="{StaticResource Hint}" />
                            <TextBox Style="{StaticResource InputTextBox}" Width="42" Text="{Binding Indicator1.PeriodText, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Width="128"
                                      ItemsSource="{Binding IndicatorChoices}"
                                      SelectedItem="{Binding Indicator2.Choice}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{Binding Indicator2.ChoiceName}" />
                            <TextBlock Text="period" Margin="6,0,4,0" Style="{StaticResource Hint}" />
                            <TextBox Style="{StaticResource InputTextBox}" Width="42" Text="{Binding Indicator2.PeriodText, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- row 2: one thin line of feedback -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,7,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding TickerHint}" Style="{StaticResource Hint}" />
                        <TextBlock Text="  |  " Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding DirectoryHint}" Style="{StaticResource Hint}" />
                        <TextBlock Text="  |  " Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding StrategyHint}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CHART -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <controls:BacktestChart Result="{Binding Result}" Margin="6" />
        </Border>

        <!-- SUMMARY -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8">
            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2,0,2" Padding="0,0,18,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Value}" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
