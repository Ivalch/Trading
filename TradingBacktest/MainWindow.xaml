<Window x:Class="TradingBacktest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TradingBacktest.Controls"
        xmlns:viewModels="clr-namespace:TradingBacktest.ViewModels"
        Title="Trading Backtest"
        Height="820"
        Width="1280"
        MinHeight="560"
        MinWidth="960"
        Background="#FFF4F6F8"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ settings ============================ -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <StackPanel>
                <!-- Row 1: data and cost -->
                <WrapPanel>
                    <StackPanel Margin="0,0,18,10" VerticalAlignment="Top">
                        <TextBlock Text="Ticker" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="170"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchEnabled="True"
                                  ItemsSource="{Binding AvailableTickers}"
                                  Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="0,0,18,10" VerticalAlignment="Top">
                        <TextBlock Text="Data folder" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="300"
                                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Browse..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="6,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"
                                    IsEnabled="{Binding CanBrowse}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,10" VerticalAlignment="Top">
                        <TextBlock Text="Period" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker Width="125" SelectedDate="{Binding FromDate}" ToolTip="First day of the tested period" />
                            <TextBlock Text="to" Margin="6,0,6,0" Foreground="{StaticResource MutedTextBrush}" />
                            <DatePicker Width="125" SelectedDate="{Binding ToDate}" ToolTip="Last day of the tested period" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,10" VerticalAlignment="Top">
                        <TextBlock Text="Quick period" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="1Y" Style="{StaticResource ChipButton}" Command="{Binding PeriodCommand}" CommandParameter="1Y" />
                            <Button Content="3Y" Style="{StaticResource ChipButton}" Margin="4,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="3Y" />
                            <Button Content="5Y" Style="{StaticResource ChipButton}" Margin="4,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="5Y" />
                            <Button Content="All" Style="{StaticResource ChipButton}" Margin="4,0,0,0" Command="{Binding PeriodCommand}" CommandParameter="All" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,10" VerticalAlignment="Top">
                        <TextBlock Text="Cost of operation, %" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="90"
                                 Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Commission, spread and tax charged on each buy and each sell, in percent" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock Text=" " />
                        <Button Content="Start" MinWidth="110" Command="{Binding StartCommand}" />
                    </StackPanel>
                </WrapPanel>

                <!-- Row 2: the buy/sell rule -->
                <WrapPanel Margin="0,4,0,0">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Top">
                        <TextBlock Text="Buy/sell rule" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="200"
                                      ItemsSource="{Binding Strategies}"
                                      SelectedItem="{Binding SelectedStrategy}"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center" />
                            <TextBox Width="46"
                                     Margin="6,0,0,0"
                                     Text="{Binding SelectedStrategy.LookbackText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Lookback used by rules that have one"
                                     Visibility="{Binding SelectedStrategy.HasLookback, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Top">
                        <TextBlock Text="Indicators" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="140"
                                      ItemsSource="{Binding AvailableIndicators}"
                                      SelectedItem="{Binding IndicatorToAdd}"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center" />
                            <Button Content="Add"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="6,0,0,0"
                                    Command="{Binding AddIndicatorCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Indicators}" VerticalAlignment="Center" Margin="0,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF2F5F8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="6,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" MinWidth="70" />
                                        <TextBlock Text="period" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,4,0" FontSize="11.5" />
                                        <TextBox Width="40" Text="{Binding PeriodText, UpdateSourceTrigger=LostFocus}" />
                                        <Button Content="x"
                                                Style="{StaticResource ChipButton}"
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                Command="{Binding DataContext.RemoveIndicatorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- Row 3: messages and hints -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding TickerHint}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                    <TextBlock Text="  |  " Foreground="{StaticResource LineBrush}" />
                    <TextBlock Text="{Binding DirectoryHint}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                    <TextBlock Text="  |  " Foreground="{StaticResource LineBrush}" />
                    <TextBlock Text="{Binding StrategyHint}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================== chart ============================== -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <controls:BacktestChart Result="{Binding Result}" Margin="6" />
        </Border>

        <!-- ============================= summary ============================= -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8">
            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2,0,2" Padding="0,0,18,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" FontSize="11" />
                                <TextBlock Text="{Binding Value}" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
