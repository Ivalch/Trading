  <!--
    Plug-ins are copied, not referenced.

    ReferenceOutputAssembly="false" keeps the host honest: the executable must not hold a
    compile-time or run-time reference to any plug-in, or deleting one would break it and
    the inversion would be only half done. But that same flag stops MSBuild copying the DLL
    next to the exe, so the copy is done explicitly by CopyIndicatorPlugins below.

    These entries exist only so the four shipped plug-ins are built and copied. The loader
    finds them by the Ind*.dll name at runtime, not from this list, so dropping a plug-in in
    by hand works exactly the same - and adding one here is optional.
  -->
  <ItemGroup>
    <PluginProject Include="..\Str.Crossover\Str.Crossover.csproj" />
    <PluginProject Include="..\Str.DonchianBreakout\Str.DonchianBreakout.csproj" />
